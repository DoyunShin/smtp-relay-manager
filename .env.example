COMPOSE_FILE=compose.yaml:compose.mysql.yaml
MYSQL_DATABASE=relay
MYSQL_USER=relay
MYSQL_PASSWORD=replace-with-a-random-password
MYSQL_ROOT_PASSWORD=replace-with-another-random-password
# URL-encode special characters in the database password.
DATABASE_URL=mysql+asyncmy://relay:replace-with-a-random-password@mysql:3306/relay
# Generate once with: openssl rand -base64 32 | tr -- '+/' '-_'
ENCRYPTION_KEY=
PUBLIC_BASE_URL=https://relay.example.com
# Trust only the actual HTTP reverse proxy hops; never use 0.0.0.0/0.
TRUSTED_PROXY_CIDRS=
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
SMTP_BIND_ADDRESS=0.0.0.0
SMTP_STOP_GRACE_PERIOD=150s
SMTP_HOSTNAME=smtp-relay.ory.kr
# Host directory containing fullchain.pem and privkey.pem; mounted read-only.
SMTP_CERT_DIR=/absolute/path/to/smtp-certificates
